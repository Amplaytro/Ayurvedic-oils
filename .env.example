# ---------------------------------------------------------------------------
# Razorpay credentials. Copy this file to `.env` and fill in the values.
# `.env` is git-ignored — never commit real keys.
#
#   cp .env.example .env
#
# The frontend only ever sees RAZORPAY_KEY_ID. RAZORPAY_KEY_SECRET stays on
# this server and is read only by server/index.js.
# ---------------------------------------------------------------------------

# From Dashboard -> Settings -> API Keys. Test keys start with rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# From Dashboard -> Settings -> Webhooks, if you want server-side fulfilment
# notifications. Without it /api/webhook returns 503.
RAZORPAY_WEBHOOK_SECRET=

# Port the API listens on.
PORT=3000

# Origins allowed to call the API, comma separated. Use your real domain(s) in
# production instead of *.
#   ALLOWED_ORIGINS=https://amplaytro.github.io
ALLOWED_ORIGINS=*

# Where the static files live. Leave as-is to serve the site from this process
# (handy locally). On a host that only runs the API, point it at a path that
# does not exist, or set STATIC_ROOT=/dev/null.
STATIC_ROOT=